<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 基础主题：把 MD3 全部 color role 指向本 App 调色板（亮/暗由 values-night/colors.xml 决定） -->
    <style name="Theme.XjtuLogin.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/md_inverse_primary</item>

        <item name="colorSecondary">@color/md_secondary</item>
        <item name="colorOnSecondary">@color/md_on_secondary</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <item name="colorTertiary">@color/md_tertiary</item>
        <item name="colorOnTertiary">@color/md_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/md_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/md_on_tertiary_container</item>

        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <item name="android:colorBackground">@color/md_background</item>
        <item name="colorOnBackground">@color/md_on_background</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorSurfaceVariant">@color/md_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorSurfaceInverse">@color/md_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/md_inverse_on_surface</item>

        <item name="colorSurfaceContainerLowest">@color/md_surface_container_lowest</item>
        <item name="colorSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="colorSurfaceContainer">@color/md_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="colorSurfaceContainerHighest">@color/md_surface_container_highest</item>

        <item name="colorOutline">@color/md_outline</item>
        <item name="colorOutlineVariant">@color/md_outline_variant</item>
        <item name="android:colorControlHighlight">@color/md_surface_tint</item>

        <item name="android:windowBackground">?attr/colorSurface</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="o_mr1">shortEdges</item>

        <!-- 全局组件皮肤 -->
        <!-- 全局组件皮肤（materialToolbarStyle 在 material 1.12 无此 attr，工具栏样式在布局里直接挂） -->
        <item name="materialCardViewFilledStyle">@style/Widget.Xjtu.Card.Filled</item>
        <item name="materialCardViewOutlinedStyle">@style/Widget.Xjtu.Card.Outlined</item>
        <item name="textInputStyle">@style/Widget.Xjtu.TextInputLayout</item>
    </style>

    <!-- 亮色：深色状态栏图标 -->
    <style name="Theme.XjtuLogin" parent="Theme.XjtuLogin.Base">
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <!-- 顶栏：大标题、无阴影、贴合 surface -->
    <style name="Widget.Xjtu.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorSurface</item>
        <item name="titleTextAppearance">@style/TextAppearance.Xjtu.ToolbarTitle</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
        <item name="navigationIconTint">?attr/colorOnSurface</item>
        <item name="android:theme">@style/ThemeOverlay.Xjtu.Toolbar</item>
    </style>

    <style name="TextAppearance.Xjtu.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.Xjtu.Toolbar" parent="">
        <item name="colorControlHighlight">@color/md_surface_tint</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
    </style>

    <!-- 卡片：大圆角 + 填充式（surfaceContainerHighest），贴近 Shizuku 的观感 -->
    <style name="Widget.Xjtu.Card.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHigh</item>
    </style>

    <style name="Widget.Xjtu.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!-- 输入框：紧凑 outlined + 12dp 圆角 -->
    <style name="Widget.Xjtu.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox.Dense">
        <item name="boxCornerRadiusTopStart">@dimen/radius_field</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_field</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_field</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_field</item>
    </style>

    <!-- 分组标题（「保活设置」「运行日志」） -->
    <style name="Widget.Xjtu.SectionTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
