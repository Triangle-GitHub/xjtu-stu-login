<?xml version="1.0" encoding="utf-8"?>
<!-- 主界面里的一行导航项（设置 / 白名单 / 通知权限） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_l"
    android:paddingVertical="@dimen/space_m">

    <ImageView
        android:id="@+id/nav_icon"
        android:layout_width="@dimen/icon_nav"
        android:layout_height="@dimen/icon_nav"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_settings"
        android:tint="?attr/colorPrimary"
        tools:ignore="UseAppTint" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nav_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            tools:text="参数设置" />

        <TextView
            android:id="@+id/nav_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            tools:text="网关 · 账号 · 轮询与 SSID" />
    </LinearLayout>

    <ImageView
        android:id="@+id/nav_chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="@dimen/space_s"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:tint="?attr/colorOutline"
        tools:ignore="UseAppTint" />
</LinearLayout>
